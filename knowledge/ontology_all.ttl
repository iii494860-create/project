d3f:SystemCallFiltering a cto:DefensiveTechnique ;
    rdfs:label "System Call Filtering"@en ;
    cto:externalId "D3-SCF" ;
    rdfs:comment "Controlling access to local computer system resources with kernel-level capabilities."@en ;
    cto:derivedFrom kb:doc_d3fend_map ;
    cto:verificationStatus "공식문서확인" .

d3f:SystemConfigurationPermissions a cto:DefensiveTechnique ;
    rdfs:label "System Configuration Permissions"@en ;
    cto:externalId "D3-SCP" ;
    rdfs:comment "Restricting system configuration modifications to a specific user or group of users."@en ;
    cto:derivedFrom kb:doc_d3fend_map ;
    cto:verificationStatus "공식문서확인" .

