# ---------------- 경보 등급

kb:tier_immediate a cto:AlertTier ;
    rdfs:label "즉시"@ko ;
    rdfs:comment "고위험 단일 행위"@ko .

kb:tier_chain a cto:AlertTier ;
    rdfs:label "체인"@ko ;
    rdfs:comment "공격 체인 성립"@ko .

kb:tier_score a cto:AlertTier ;
    rdfs:label "점수"@ko ;
    rdfs:comment "행위자 누적 위험 점수 초과"@ko .

kb:tier_info a cto:AlertTier ;
    rdfs:label "정보"@ko ;
    rdfs:comment "기록·점수 누적만"@ko .

# ---------------- 탐지 규칙 (팀설계. 임계값은 초기값, 정상·공격 로그 실측으로 조정)

kb:rule_sg_open_world a cto:DetectionRule ;
    rdfs:label "보안그룹 전체 개방"@ko ;
    cto:alertTier kb:tier_immediate ;
    cto:ruleType "filter" ;
    cto:filter "payload.security_group_rule.direction == ingress" ;
    cto:filter "payload.security_group_rule.remote_ip_prefix in 0.0.0.0/0|::/0|__empty__" ;
    cto:filter "payload.security_group_rule.remote_group_id empty" ;
    cto:filter "payload.security_group_rule.port_range_min covers_port 22|3389|any" ;
    cto:usesEvent kb:ev_nt_security_group_rule_create ;
    cto:usesBehavior kb:bc_firewall_rule_add ;
    cto:detects kb:T1686_001 ;
    cto:condition "direction=ingress 이고 (remote_ip_prefix 가 0.0.0.0/0 또는 ::/0 이거나, remote_ip_prefix 와 remote_group_id 가 모두 비어 있음) 이며 포트 범위가 전체이거나 22·3389 를 포함"@ko ;
    cto:severity "critical" ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_admin_role_grant a cto:DetectionRule ;
    rdfs:label "관리자 역할 부여"@ko ;
    cto:alertTier kb:tier_immediate ;
    cto:ruleType "filter" ;
    cto:filter "payload.role in_allowlist admin_role_id" ;
    cto:filter "@user not_in_allowlist service_account|automation_account" ;
    cto:usesEvent kb:ev_ks_ra_created ;
    cto:usesBehavior kb:bc_privilege_grant ;
    cto:detects kb:T1098_003 ;
    cto:condition "payload.role 이 admin 역할 ID 이고 행위자가 허용 목록에 없음"@ko ;
    cto:severity "high" ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_identity_infra_change a cto:DetectionRule ;
    rdfs:label "인증 인프라 설정 변경"@ko ;
    cto:alertTier kb:tier_immediate ;
    cto:ruleType "filter" ;
    cto:filter "@user not_in_allowlist service_account|automation_account" ;
    cto:usesBehavior kb:bc_identity_infra_change ;
    cto:condition "정책·엔드포인트·서비스·도메인·리전·역할 정의 변경을 허용 목록 밖 행위자가 수행"@ko ;
    cto:severity "high" ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_bruteforce a cto:DetectionRule ;
    rdfs:label "Keystone 무차별 대입"@ko ;
    cto:alertTier kb:tier_immediate ;
    cto:ruleType "threshold" ;
    cto:groupBy "@ip" ;
    cto:usesEvent kb:ev_ks_auth_failure ;
    cto:usesBehavior kb:bc_auth_failure ;
    cto:detects kb:T1110 ;
    cto:condition "같은 출발지 IP에서 300초 안에 인증 실패 10회 이상이면 경보. 이 규칙은 비밀번호 변경 여부나 공격과 설정 오류의 원인을 구분하지 않음(팀 설계)"@ko ;
    cto:severity "medium" ;
    cto:threshold 10 ;
    cto:windowSeconds 300 ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_mass_create a cto:DetectionRule ;
    rdfs:label "인스턴스 대량 생성"@ko ;
    cto:alertTier kb:tier_score ;
    cto:ruleType "threshold" ;
    cto:filter "@project not_in_allowlist protected_resource" ;
    cto:groupBy "@project" ;
    cto:usesEvent kb:ev_nova_instance_create ;
    cto:usesBehavior kb:bc_compute_create ;
    cto:detects kb:T1578_002 , kb:T1496_001 ;
    cto:condition "허용 목록 밖 프로젝트에서 600초 안에 인스턴스 10개 이상 (임계값은 정상 운영 로그로 조정 필요). 단독 경보 대신 사건 맥락·점수로 사용"@ko ;
    cto:severity "medium" ;
    cto:threshold 10 ;
    cto:windowSeconds 600 ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_fail_then_success a cto:DetectionRule ;
    rdfs:label "실패 반복 후 로그인 성공"@ko ;
    cto:alertTier kb:tier_chain ;
    cto:ruleType "sequence" ;
    cto:groupBy "@ip" ;
    cto:sequenceStep "1:rule_bruteforce|rule_password_guessing|rule_password_spraying" ;
    cto:sequenceStep "2:bc_auth_success" ;
    cto:usesEvent kb:ev_ks_auth_failure , kb:ev_ks_auth_success ;
    cto:usesBehavior kb:bc_auth_failure , kb:bc_auth_success ;
    cto:detects kb:T1078_004 ;
    cto:condition "무차별 대입 경보가 난 IP 에서 600초 안에 인증 성공"@ko ;
    cto:severity "high" ;
    cto:windowSeconds 600 ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_takeover_then_privilege a cto:DetectionRule ;
    rdfs:label "의심 로그인 후 권한 확대"@ko ;
    cto:alertTier kb:tier_chain ;
    cto:ruleType "sequence" ;
    cto:groupBy "@user" ;
    cto:sequenceStep "1:rule_fail_then_success|bc_auth_success@new_source" ;
    cto:sequenceStep "2:bc_privilege_grant|bc_account_create" ;
    cto:usesBehavior kb:bc_auth_success , kb:bc_privilege_grant , kb:bc_account_create ;
    cto:detects kb:T1098_003 , kb:T1136_003 ;
    cto:condition "의심 로그인(실패 반복 후 성공 또는 처음 보는 IP) 이후 3600초 안에 같은 사용자가 역할 부여 또는 계정 생성"@ko ;
    cto:severity "critical" ;
    cto:windowSeconds 3600 ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_privilege_then_compute a cto:DetectionRule ;
    rdfs:label "권한 확대 후 자원 생성"@ko ;
    cto:alertTier kb:tier_chain ;
    cto:ruleType "sequence" ;
    cto:groupBy "@user" ;
    cto:sequenceStep "1:bc_privilege_grant" ;
    cto:sequenceStep "2:bc_compute_create" ;
    cto:minCount 3 ;
    cto:usesBehavior kb:bc_privilege_grant , kb:bc_compute_create ;
    cto:detects kb:T1578_002 ;
    cto:condition "역할 부여 이후 3600초 안에 같은 사용자가 인스턴스 3개 이상 생성"@ko ;
    cto:severity "high" ;
    cto:threshold 3 ;
    cto:windowSeconds 3600 ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_compute_then_exposure a cto:DetectionRule ;
    rdfs:label "생성 자원의 외부 노출"@ko ;
    cto:alertTier kb:tier_chain ;
    cto:ruleType "sequence" ;
    cto:groupBy "@project" ;
    cto:sequenceStep "1:bc_compute_create" ;
    cto:sequenceStep "2:rule_sg_open_world|bc_external_exposure" ;
    cto:usesBehavior kb:bc_compute_create , kb:bc_firewall_rule_add , kb:bc_external_exposure ;
    cto:detects kb:T1686_001 ;
    cto:condition "같은 프로젝트에서 인스턴스 생성 후 3600초 안에 보안그룹 개방(sg_open_world) 또는 Floating IP 연결"@ko ;
    cto:severity "critical" ;
    cto:windowSeconds 3600 ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_password_guessing a cto:DetectionRule ;
    rdfs:label "비밀번호 추측"@ko ;
    cto:alertTier kb:tier_immediate ;
    cto:ruleType "threshold" ;
    cto:groupBy "@user" ;
    cto:distinctField "payload.attachments[name=partial_password_hash].content" ;
    cto:distinctMin 3 ;
    cto:usesEvent kb:ev_ks_auth_failure ;
    cto:usesBehavior kb:bc_auth_failure ;
    cto:detects kb:T1110_001 ;
    cto:condition "같은 계정에 300초 안에 인증 실패 10회 이상이고, 비밀번호 부분 해시가 서로 다른 3종 이상일 때 경보. 해시 필드가 없거나 3종 미만이면 이 규칙의 경보를 만들지 않음(팀 설계)"@ko ;
    cto:severity "medium" ;
    cto:threshold 10 ;
    cto:windowSeconds 300 ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_password_spraying a cto:DetectionRule ;
    rdfs:label "비밀번호 스프레이"@ko ;
    cto:alertTier kb:tier_immediate ;
    cto:ruleType "threshold" ;
    cto:groupBy "@ip" ;
    cto:distinctField "payload.initiator.id" ;
    cto:distinctMin 5 ;
    cto:usesEvent kb:ev_ks_auth_failure ;
    cto:usesBehavior kb:bc_auth_failure ;
    cto:detects kb:T1110_003 ;
    cto:condition "같은 출발지 IP 에서 300초 안에 서로 다른 계정 5개 이상 인증 실패"@ko ;
    cto:severity "medium" ;
    cto:threshold 5 ;
    cto:windowSeconds 300 ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_image_share_external a cto:DetectionRule ;
    rdfs:label "이미지 외부 프로젝트 공유"@ko ;
    cto:alertTier kb:tier_immediate ;
    cto:ruleType "filter" ;
    cto:filter "payload.member_id not_in_allowlist trusted_project" ;
    cto:usesEvent kb:ev_gl_image_member_create ;
    cto:usesBehavior kb:bc_image_share ;
    cto:detects kb:T1537 ;
    cto:condition "이미지가 다른 프로젝트에 공유됨. 공유 이벤트에는 소유자 필드가 없어 모든 공유를 외부 공유로 보고, 신뢰 프로젝트만 제외"@ko ;
    cto:severity "high" ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_image_send_cross_project a cto:DetectionRule ;
    rdfs:label "이미지 다른 프로젝트로 전송"@ko ;
    cto:alertTier kb:tier_immediate ;
    cto:ruleType "filter" ;
    cto:filter "payload.receiver_tenant_id ne_field payload.owner_id" ;
    cto:filter "payload.image_id not_in_allowlist trusted_image" ;
    cto:usesEvent kb:ev_gl_image_send ;
    cto:usesBehavior kb:bc_image_transfer ;
    cto:detects kb:T1537 ;
    cto:condition "받는 쪽 프로젝트가 이미지 소유자와 다르고 신뢰 이미지가 아님. 공개 이미지로 다른 프로젝트가 인스턴스를 만들 때도 발생하므로 신뢰 이미지 목록을 채워야 오탐이 줄어듦"@ko ;
    cto:severity "medium" ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_keypair_after_takeover a cto:DetectionRule ;
    rdfs:label "의심 로그인 후 키페어 등록"@ko ;
    cto:alertTier kb:tier_chain ;
    cto:ruleType "sequence" ;
    cto:groupBy "@user" ;
    cto:sequenceStep "1:rule_fail_then_success|bc_auth_success@new_source" ;
    cto:sequenceStep "2:bc_credential_add" ;
    cto:usesBehavior kb:bc_auth_success , kb:bc_credential_add ;
    cto:detects kb:T1098_001 ;
    cto:condition "의심 로그인(실패 반복 후 성공 또는 처음 보는 IP) 이후 3600초 안에 같은 사용자가 키페어 생성·등록"@ko ;
    cto:severity "high" ;
    cto:windowSeconds 3600 ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_risk_accumulation a cto:DetectionRule ;
    rdfs:label "누적 위험 점수 초과"@ko ;
    cto:alertTier kb:tier_score ;
    cto:ruleType "score" ;
    cto:filter "@actor not_in_allowlist service_account|automation_account|admin_ip" ;
    cto:groupBy "@actor" ;
    cto:condition "행위자(사용자 또는 IP)별로 3600초 동안 행위 분류 riskScore 합이 50 이상"@ko ;
    cto:severity "medium" ;
    cto:threshold 50 ;
    cto:windowSeconds 3600 ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

# ---------------- 명령 인자 (자리표시자 ← 로그 필드. LLM이 값을 만들지 않음)

kb:param_user a cto:CommandParameter ;
    cto:placeholder "<user>" ;
    cto:valueFrom kb:f_ks_initiator_id , kb:f_ks_ra_user , kb:f_nova_user , kb:f_nova_kp_user .

kb:param_created_user a cto:CommandParameter ;
    cto:placeholder "<created_user>" ;
    cto:valueFrom kb:f_ks_resource_info .

kb:param_image a cto:CommandParameter ;
    cto:placeholder "<image>" ;
    cto:valueFrom kb:f_gl_image_id .

kb:param_member_project a cto:CommandParameter ;
    cto:placeholder "<member-project>" ;
    cto:valueFrom kb:f_gl_member_id , kb:f_gl_recv_tenant .

kb:param_keypair a cto:CommandParameter ;
    cto:placeholder "<keypair>" ;
    cto:valueFrom kb:f_nova_kp_name .

kb:param_project a cto:CommandParameter ;
    cto:placeholder "<project>" ;
    cto:valueFrom kb:f_ks_ra_project , kb:f_nova_tenant , kb:f_nt_sgr_project , kb:f_nt_fip_project , kb:f_nt_port_project .

kb:param_role a cto:CommandParameter ;
    cto:placeholder "<role>" ;
    cto:valueFrom kb:f_ks_ra_role .

kb:param_server a cto:CommandParameter ;
    cto:placeholder "<server>" ;
    cto:valueFrom kb:f_nova_uuid , kb:f_nt_port_device .

kb:param_rule a cto:CommandParameter ;
    cto:placeholder "<rule>" ;
    cto:valueFrom kb:f_nt_sgr_id .

kb:param_security_group a cto:CommandParameter ;
    cto:placeholder "<security-group>" ;
    cto:valueFrom kb:f_nt_sgr_sg .

kb:param_floating_ip a cto:CommandParameter ;
    cto:placeholder "<floating-ip>" ;
    cto:valueFrom kb:f_nt_fip_id .

kb:param_port a cto:CommandParameter ;
    cto:placeholder "<port>" ;
    cto:valueFrom kb:f_nt_fip_port , kb:f_nt_port_id , kb:f_nova_port .

# ---------------- 자동 조사 항목 (읽기 전용, 에이전트 자동 실행)

kb:inv_user_show a cto:InvestigationQuery ;
    rdfs:label "계정 정보 조회"@ko ;
    cto:command "openstack user show <user>" ;
    cto:hasParameter kb:param_user ;
    cto:purpose "계정 상태·도메인·활성 여부 확인"@ko ;
    cto:derivedFrom kb:doc_osc , kb:doc_osc_help ;
    cto:verificationStatus "공식문서확인" .

kb:inv_role_list a cto:InvestigationQuery ;
    rdfs:label "계정의 역할 목록"@ko ;
    cto:command "openstack role assignment list --user <user> --names" ;
    cto:hasParameter kb:param_user ;
    cto:purpose "보유 권한·최근 추가 역할 확인"@ko ;
    cto:derivedFrom kb:doc_osc ;
    cto:verificationStatus "공식문서확인" .

kb:inv_server_by_user a cto:InvestigationQuery ;
    rdfs:label "계정이 만든 인스턴스"@ko ;
    cto:command "openstack server list --all-projects --user <user>" ;
    cto:hasParameter kb:param_user ;
    cto:purpose "탈취 계정으로 생성된 인스턴스 파악"@ko ;
    cto:derivedFrom kb:doc_osc ;
    cto:verificationStatus "공식문서확인" .

kb:inv_server_by_project a cto:InvestigationQuery ;
    rdfs:label "프로젝트 인스턴스"@ko ;
    cto:command "openstack server list --all-projects --project <project>" ;
    cto:hasParameter kb:param_project ;
    cto:purpose "대량 생성 여부 확인"@ko ;
    cto:derivedFrom kb:doc_osc ;
    cto:verificationStatus "공식문서확인" .

kb:inv_server_show a cto:InvestigationQuery ;
    rdfs:label "인스턴스 상세"@ko ;
    cto:command "openstack server show <server>" ;
    cto:hasParameter kb:param_server ;
    cto:purpose "사양·이미지·보안그룹·네트워크 확인"@ko ;
    cto:derivedFrom kb:doc_osc , kb:doc_osc_help ;
    cto:verificationStatus "공식문서확인" .

kb:inv_sg_rule_list a cto:InvestigationQuery ;
    rdfs:label "보안그룹 규칙 목록"@ko ;
    cto:command "openstack security group rule list <security-group>" ;
    cto:hasParameter kb:param_security_group ;
    cto:purpose "전체 개방 규칙·개방 포트 확인"@ko ;
    cto:derivedFrom kb:doc_osc , kb:doc_osc_help ;
    cto:verificationStatus "공식문서확인" .

kb:inv_fip_list a cto:InvestigationQuery ;
    rdfs:label "프로젝트 Floating IP"@ko ;
    cto:command "openstack floating ip list --project <project>" ;
    cto:hasParameter kb:param_project ;
    cto:purpose "외부 노출 인스턴스 확인"@ko ;
    cto:derivedFrom kb:doc_osc ;
    cto:verificationStatus "공식문서확인" .

kb:inv_image_show a cto:InvestigationQuery ;
    rdfs:label "이미지 상세"@ko ;
    cto:command "openstack image show <image>" ;
    cto:hasParameter kb:param_image ;
    cto:purpose "소유자·공개 여부·생성 시각 확인"@ko ;
    cto:derivedFrom kb:doc_osc , kb:doc_osc_help ;
    cto:verificationStatus "공식문서확인" .

kb:inv_image_member_list a cto:InvestigationQuery ;
    rdfs:label "이미지 공유 대상 목록"@ko ;
    cto:command "openstack image member list <image>" ;
    cto:hasParameter kb:param_image ;
    cto:purpose "어느 프로젝트에 공유됐는지 확인"@ko ;
    cto:derivedFrom kb:doc_osc , kb:doc_osc_help ;
    cto:verificationStatus "공식문서확인" .

kb:inv_keypair_list_user a cto:InvestigationQuery ;
    rdfs:label "사용자의 키페어 목록"@ko ;
    cto:command "openstack keypair list --user <user>" ;
    cto:hasParameter kb:param_user ;
    cto:purpose "공격자가 등록한 키페어 확인"@ko ;
    cto:derivedFrom kb:doc_osc , kb:doc_osc_help ;
    cto:verificationStatus "공식문서확인" .

kb:inv_server_by_image a cto:InvestigationQuery ;
    rdfs:label "이미지로 만든 인스턴스"@ko ;
    cto:command "openstack server list --all-projects --image <image>" ;
    cto:hasParameter kb:param_image ;
    cto:purpose "해당 이미지로 실행된 인스턴스 파악"@ko ;
    cto:derivedFrom kb:doc_osc , kb:doc_osc_help ;
    cto:verificationStatus "공식문서확인" .

kb:bc_auth_failure cto:investigateWith kb:inv_user_show , kb:inv_role_list .

kb:bc_auth_success cto:investigateWith kb:inv_user_show , kb:inv_role_list , kb:inv_server_by_user .

kb:bc_privilege_grant cto:investigateWith kb:inv_role_list , kb:inv_user_show .

kb:bc_account_create cto:investigateWith kb:inv_user_show , kb:inv_role_list .

kb:bc_account_modify cto:investigateWith kb:inv_user_show , kb:inv_role_list .

kb:bc_compute_create cto:investigateWith kb:inv_server_show , kb:inv_server_by_project .

kb:bc_firewall_rule_add cto:investigateWith kb:inv_sg_rule_list .

kb:bc_firewall_change cto:investigateWith kb:inv_sg_rule_list .

kb:bc_external_exposure cto:investigateWith kb:inv_fip_list .

kb:bc_identity_infra_change cto:investigateWith kb:inv_user_show , kb:inv_role_list .

kb:bc_discovery cto:investigateWith kb:inv_user_show , kb:inv_role_list .

kb:bc_credential_add cto:investigateWith kb:inv_keypair_list_user , kb:inv_user_show .

kb:bc_snapshot_create cto:investigateWith kb:inv_server_show .

kb:bc_image_register cto:investigateWith kb:inv_image_show .

kb:bc_image_transfer cto:investigateWith kb:inv_image_show , kb:inv_server_by_image .

