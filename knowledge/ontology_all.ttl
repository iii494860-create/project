    cto:externalId "TA0002" ;
    cto:tacticOrder 4 .

kb:TA0040 a cto:Tactic ;
    rdfs:label "Impact"@en ;
    cto:externalId "TA0040" ;
    cto:tacticOrder 15 .

kb:TA0003 a cto:Tactic ;
