# 자동 생성: MITRE ATT&CK v19.2 (플랫폼: IaaS,Identity Provider)
kb:doc_attack a cto:SourceDocument ;
    rdfs:label "MITRE ATT&CK Enterprise" ;
    cto:url "https://attack.mitre.org"^^xsd:anyURI .

