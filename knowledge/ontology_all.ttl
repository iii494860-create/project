    cto:typeURI "data/security/group" ;
    cto:derivedFrom kb:doc_keystone_notif ;
    cto:verificationStatus "공식문서확인" .

kb:res_instance a cto:ResourceType ;
    rdfs:label "인스턴스"@ko ;
    cto:providedBy kb:Nova ;
    cto:apiResourceName "instance" ;
    cto:sensitivity "medium" ;
    cto:derivedFrom kb:doc_nova_notif ;
    cto:verificationStatus "공식문서확인" .

kb:res_keypair a cto:ResourceType ;
    rdfs:label "키페어"@ko ;
    cto:providedBy kb:Nova ;
    cto:apiResourceName "keypair" ;
    cto:sensitivity "high" ;
