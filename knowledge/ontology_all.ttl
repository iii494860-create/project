    cto:externalId "TA0003" ;
    cto:tacticOrder 5 .

kb:TA0004 a cto:Tactic ;
    rdfs:label "Privilege Escalation"@en ;
    cto:externalId "TA0004" ;
    cto:tacticOrder 6 .

kb:TA0008 a cto:Tactic ;
