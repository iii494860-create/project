# 자동 생성: D3FEND 공식 매핑 (ATT&CK Mitigation → D3FEND)
kb:doc_d3fend_map a cto:SourceDocument ;
    rdfs:label "D3FEND: ATT&CK Mitigations to D3FEND Technique Mappings" ;
    cto:url "https://d3fend.mitre.org/mappings/attack-mitigations"^^xsd:anyURI .

d3f:DomainTrustPolicy a cto:DefensiveTechnique ;
    rdfs:label "Domain Trust Policy"@en ;
    cto:externalId "D3-DTP" ;
    rdfs:comment "Restricting inter-domain trust by modifying domain configuration."@en ;
    cto:derivedFrom kb:doc_d3fend_map ;
    cto:verificationStatus "공식문서확인" .

kb:M1015 cto:mappedToD3FEND d3f:DomainTrustPolicy ;
    cto:mappedToD3FEND d3f:AuthenticationCacheInvalidation ;
    cto:mappedToD3FEND d3f:UserAccountPermissions .

d3f:AuthenticationCacheInvalidation a cto:DefensiveTechnique ;
    rdfs:label "Authentication Cache Invalidation"@en ;
    cto:externalId "D3-ANCI" ;
    rdfs:comment "Removing tokens or credentials from an authentication cache to prevent further user associated account accesses."@en ;
    cto:derivedFrom kb:doc_d3fend_map ;
    cto:verificationStatus "공식문서확인" .

d3f:UserAccountPermissions a cto:DefensiveTechnique ;
    rdfs:label "User Account Permissions"@en ;
    cto:externalId "D3-UAP" ;
    rdfs:comment "Restricting a user account's access to resources."@en ;
    cto:derivedFrom kb:doc_d3fend_map ;
    cto:verificationStatus "공식문서확인" .

d3f:LocalFilePermissions a cto:DefensiveTechnique ;
    rdfs:label "Local File Permissions"@en ;
    cto:externalId "D3-LFP" ;
    rdfs:comment "Local file permissions is the systematic process of defining, implementing, and managing access control policies that dictate user permissions for accessing files on a local system through the configuration of operating system functionality."@en ;
    cto:derivedFrom kb:doc_d3fend_map ;
    cto:verificationStatus "공식문서확인" .

