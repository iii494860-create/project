    rdfs:label "탐지 규칙별 대응"@ko ; rdfs:domain cto:DetectionRule ; rdfs:range cto:ResponseAction .

# CTO_APPLICATION_CREDENTIAL_V1

kb:doc_appcredential a cto:SourceDocument ;
    rdfs:label "Keystone Application Credentials"@ko ;
    cto:url "https://docs.openstack.org/keystone/latest/user/application_credentials.html"^^xsd:anyURI ;
    rdfs:comment "2026-11-17 cto-test 실제 생성·삭제 CADF 알림과 설치된 CLI 도움말 확인. 사용 인증 로그 연결은 미확인."@ko .

kb:res_application_credential a cto:ResourceType ;
    rdfs:label "Application Credential"@ko ;
    cto:providedBy kb:Keystone ;
    cto:apiResourceName "application_credential" ;
    cto:typeURI "data/security/credential" ;
    cto:sensitivity "high" ;
    cto:derivedFrom kb:doc_appcredential ;
    cto:verificationStatus "공식문서확인" .

kb:field_appcredential_user a cto:LogField ;
    rdfs:label "자격증명 작업 수행자"@ko ;
    cto:fieldPath "payload.initiator.user_id" , "payload.initiator.id" ;
    cto:refersTo kb:res_user ;
    cto:isCorrelationKey true ;
    cto:derivedFrom kb:doc_appcredential ;
    cto:verificationStatus "공식문서확인" .

kb:field_appcredential_project a cto:LogField ;
    rdfs:label "자격증명 발급 프로젝트"@ko ;
    cto:fieldPath "payload.initiator.project_id" , "_context_project_id" ;
    cto:refersTo kb:res_project ;
    cto:isCorrelationKey true ;
    cto:derivedFrom kb:doc_appcredential ;
    cto:verificationStatus "공식문서확인" .

kb:field_appcredential_id a cto:LogField ;
    rdfs:label "Application Credential ID"@ko ;
    cto:fieldPath "payload.resource_info" , "payload.target.id" ;
    cto:refersTo kb:res_application_credential ;
    cto:isCorrelationKey false ;
    cto:derivedFrom kb:doc_appcredential ;
    cto:verificationStatus "공식문서확인" .

kb:bc_appcredential_create a cto:BehaviorClass ;
    rdfs:label "Application Credential 생성"@ko ;
    cto:riskScore 0 ;
    cto:matchesAction kb:act_create ;
    cto:matchesResourceType kb:res_application_credential ;
    cto:derivedFrom kb:doc_appcredential ;
    cto:verificationStatus "팀설계" ;
    rdfs:comment "성공·실패 생성/삭제 기록을 보존한다. 단독 발급은 공격 판정이 아니며 자격증명 사용 성공도 뜻하지 않는다."@ko ;
    cto:suggestsTechnique kb:T1098_001 .

kb:ev_appcredential_create a cto:LogEventType ;
    rdfs:label "Keystone Application Credential 생성"@ko ;
    cto:eventTypeName "identity.application_credential.created" ;
    cto:emittedBy kb:Keystone ;
    cto:viaChannel kb:ch_keystone_cadf ;
    cto:hasAction kb:act_create ;
    cto:onResourceType kb:res_application_credential ;
    cto:classifiedAs kb:bc_appcredential_create ;
    cto:hasField kb:field_appcredential_user , kb:field_appcredential_project , kb:field_appcredential_id , kb:f_ks_src_ip , kb:f_ks_request_id , kb:f_ks_outcome , kb:f_ks_target_type , kb:f_ks_initiator_username , kb:f_ks_agent ;
    cto:derivedFrom kb:doc_appcredential ;
    cto:verificationStatus "공식문서확인" .

kb:bc_appcredential_delete a cto:BehaviorClass ;
    rdfs:label "Application Credential 삭제"@ko ;
    cto:riskScore 0 ;
    cto:matchesAction kb:act_delete ;
    cto:matchesResourceType kb:res_application_credential ;
    cto:derivedFrom kb:doc_appcredential ;
    cto:verificationStatus "팀설계" ;
    rdfs:comment "성공·실패 생성/삭제 기록을 보존한다. 단독 발급은 공격 판정이 아니며 자격증명 사용 성공도 뜻하지 않는다."@ko .

kb:ev_appcredential_delete a cto:LogEventType ;
    rdfs:label "Keystone Application Credential 삭제"@ko ;
    cto:eventTypeName "identity.application_credential.deleted" ;
    cto:emittedBy kb:Keystone ;
    cto:viaChannel kb:ch_keystone_cadf ;
    cto:hasAction kb:act_delete ;
    cto:onResourceType kb:res_application_credential ;
    cto:classifiedAs kb:bc_appcredential_delete ;
    cto:hasField kb:field_appcredential_user , kb:field_appcredential_project , kb:field_appcredential_id , kb:f_ks_src_ip , kb:f_ks_request_id , kb:f_ks_outcome , kb:f_ks_target_type , kb:f_ks_initiator_username , kb:f_ks_agent ;
    cto:derivedFrom kb:doc_appcredential ;
    cto:verificationStatus "공식문서확인" .

kb:param_application_credential a cto:CommandParameter ;
    rdfs:label "확인된 Application Credential ID"@ko ;
    cto:placeholder "<application-credential>" ;
    cto:valueFrom kb:field_appcredential_id .

kb:inv_appcredential_show a cto:InvestigationQuery ;
    rdfs:label "Application Credential 속성 확인"@ko ;
    cto:command "openstack application credential show <application-credential>" ;
    cto:hasParameter kb:param_application_credential ;
    cto:purpose "자격증명 소유자 계정의 적절한 인증 문맥에서 프로젝트·역할·만료 확인. ID만으로 소유 계정을 바꿀 수 없으며 404는 삭제 또는 접근 범위 차이일 수 있다."@ko ;
    cto:derivedFrom kb:doc_appcredential ;
    cto:verificationStatus "공식문서확인" .

kb:resp_appcredential_delete a cto:ResponseAction ;
    rdfs:label "확인된 비승인 Application Credential 폐기"@ko ;
    cto:command "openstack application credential delete <application-credential>" ;
    cto:hasParameter kb:param_application_credential ;
    cto:requiresApproval true ;
    rdfs:comment "소유 계정·프로젝트·업무 영향 확인 후 승인된 사용자 인증 문맥에서 실행. 기존 secret 복원 불가. 삭제 이벤트에는 재삭제를 권고하지 않는다."@ko ;
    cto:derivedFrom kb:doc_appcredential ;
    cto:verificationStatus "공식문서확인" .

kb:bc_appcredential_create cto:investigateWith kb:inv_appcredential_show .

kb:bc_appcredential_delete cto:investigateWith kb:inv_appcredential_show .

kb:rule_appcredential_after_takeover a cto:DetectionRule ;
    rdfs:label "의심 로그인 후 Application Credential 발급"@ko ;
    cto:ruleType "appcredential_sequence" ;
    cto:alertTier kb:tier_chain ;
    cto:usesEvent kb:ev_appcredential_create ;
    cto:usesBehavior kb:bc_appcredential_create ;
    cto:detects kb:T1098_001 ;
    cto:severity "high" ;
    cto:windowSeconds 3600 ;
    cto:groupBy "@user" ;
    cto:sequenceStep "1:rule_fail_then_success" , "2:bc_appcredential_create" ;
    cto:condition "실패 반복 후 성공 경보에 포함된 성공 로그인과 동일 사용자·출발지 IP에서 3600초 이내 자격증명 생성 성공. 발급 프로젝트·자격증명 ID 필수, 알려진 프로젝트 불일치·승인 자격증명 제외. 단순 신규 IP는 제외. 발급 의심이며 자격증명 사용·침해 확정 아님."@ko ;
    cto:ruleResponse kb:resp_appcredential_delete ;
    cto:derivedFrom kb:doc_team_scenario ;
    cto:verificationStatus "팀설계" .

kb:rule_keypair_after_takeover cto:ruleResponse kb:resp_keypair_delete .

cto:implementedBy a owl:ObjectProperty ;
    rdfs:domain cto:DetectionStrategy ; rdfs:range cto:DetectionRule .
