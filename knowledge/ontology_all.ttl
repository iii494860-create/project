    cto:viaChannel kb:ch_keystone_cadf ;
    cto:hasAction kb:act_authenticate ;
    cto:onResourceType kb:res_user ;
    cto:classifiedAs kb:bc_auth_failure ;
    cto:hasField kb:f_ks_initiator_id , kb:f_ks_initiator_user_id , kb:f_ks_src_ip , kb:f_ks_agent , kb:f_ks_request_id , kb:f_ks_action , kb:f_ks_outcome , kb:f_ks_target_id , kb:f_ks_target_type , kb:f_ks_initiator_username , kb:f_ks_reason_code , kb:f_ks_pw_hash , kb:f_ks_cred_type , kb:f_ks_cred_idp , kb:f_ks_cred_groups ;
