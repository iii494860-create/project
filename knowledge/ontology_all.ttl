# ---------------- 대응 권고 (관리자 승인 후 실행)

# 참고: 토큰 폐기(openstack token revoke <token>)는 로그에 토큰 값이 없어 인자를 채울 수 없으므로 제외

kb:resp_disable_user a cto:ResponseAction ;
    rdfs:label "사용자 비활성화"@ko ;
    cto:command "openstack user set --disable <user>" ;
    cto:requiresApproval true ;
    cto:rollbackCommand "openstack user set --enable <user>" ;
    cto:hasParameter kb:param_user ;
    cto:implements d3f:AccountLocking ;
    cto:derivedFrom kb:doc_osc , kb:doc_osc_help ;
    cto:verificationStatus "공식문서확인" .

kb:resp_disable_created_user a cto:ResponseAction ;
    rdfs:label "새로 생성된 계정 비활성화"@ko ;
    cto:command "openstack user set --disable <created_user>" ;
    cto:requiresApproval true ;
    cto:rollbackCommand "openstack user set --enable <created_user>" ;
    cto:hasParameter kb:param_created_user ;
    cto:implements d3f:AccountLocking ;
    cto:derivedFrom kb:doc_osc , kb:doc_osc_help ;
    cto:verificationStatus "공식문서확인" .

kb:resp_remove_role a cto:ResponseAction ;
    rdfs:label "부여된 역할 회수"@ko ;
    cto:command "openstack role remove --user <user> --project <project> <role>" ;
    cto:requiresApproval true ;
    cto:rollbackCommand "openstack role add --user <user> --project <project> <role>" ;
    cto:hasParameter kb:param_user , kb:param_project , kb:param_role ;
    cto:implements d3f:UserAccountPermissions ;
    cto:derivedFrom kb:doc_osc ;
    cto:verificationStatus "공식문서확인" .

kb:resp_stop_server a cto:ResponseAction ;
    rdfs:label "의심 인스턴스 정지"@ko ;
    cto:command "openstack server stop <server>" ;
    cto:requiresApproval true ;
    cto:rollbackCommand "openstack server start <server>" ;
    cto:hasParameter kb:param_server ;
    cto:derivedFrom kb:doc_osc , kb:doc_osc_help ;
    cto:verificationStatus "공식문서확인" .

kb:resp_delete_sg_rule a cto:ResponseAction ;
    rdfs:label "개방된 보안그룹 규칙 삭제"@ko ;
    cto:command "openstack security group rule delete <rule>" ;
    cto:requiresApproval true ;
    rdfs:comment "되돌리기 명령 없음. 실행 전 규칙 내용을 조사 결과로 보관해 재생성 가능하게 할 것"@ko ;
    cto:hasParameter kb:param_rule ;
    cto:implements d3f:InboundTrafficFiltering ;
    cto:derivedFrom kb:doc_osc , kb:doc_osc_help ;
    cto:verificationStatus "공식문서확인" .

kb:resp_unset_fip a cto:ResponseAction ;
    rdfs:label "Floating IP 연결 해제"@ko ;
    cto:command "openstack floating ip unset --port <floating-ip>" ;
    cto:requiresApproval true ;
    cto:rollbackCommand "openstack floating ip set --port <port> <floating-ip>" ;
    cto:hasParameter kb:param_floating_ip , kb:param_port ;
    cto:implements d3f:InboundTrafficFiltering ;
    cto:derivedFrom kb:doc_osc ;
    cto:verificationStatus "공식문서확인" .

kb:resp_image_unshare a cto:ResponseAction ;
    rdfs:label "이미지 공유 취소"@ko ;
    cto:command "openstack image remove project <image> <member-project>" ;
    cto:requiresApproval true ;
    rdfs:comment "되돌리기 명령(공유 다시 추가)은 아직 공식 확인 안 함"@ko ;
    cto:hasParameter kb:param_image , kb:param_member_project ;
    cto:derivedFrom kb:doc_osc , kb:doc_osc_help ;
    cto:verificationStatus "공식문서확인" .

kb:resp_image_deactivate a cto:ResponseAction ;
    rdfs:label "의심 이미지 비활성화"@ko ;
    cto:command "openstack image set --deactivate <image>" ;
    cto:requiresApproval true ;
    cto:rollbackCommand "openstack image set --activate <image>" ;
    cto:hasParameter kb:param_image ;
    cto:derivedFrom kb:doc_osc , kb:doc_osc_help ;
    cto:verificationStatus "공식문서확인" .

kb:resp_keypair_delete a cto:ResponseAction ;
    rdfs:label "공격자 키페어 삭제"@ko ;
    cto:command "openstack keypair delete --user <user> <keypair>" ;
    cto:requiresApproval true ;
    rdfs:comment "되돌리기 없음. 로그의 공개키로 재등록할 수 있는지는 확인 안 함"@ko ;
    cto:hasParameter kb:param_user , kb:param_keypair ;
    cto:derivedFrom kb:doc_osc , kb:doc_osc_help ;
    cto:verificationStatus "공식문서확인" .

