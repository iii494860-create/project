kb:cinder_tier_watch a cto:AlertTier ;
    rdfs:label "주의"@ko .
kb:cinder_tier_audit a cto:AlertTier ;
    rdfs:label "정보성 감사"@ko .
kb:cinder_strategy_snapshot_burst a cto:DetectionStrategy ;
    rdfs:label "Cinder 스냅샷 단시간 다량 생성 감시"@ko .
kb:cinder_strategy_volume_burst a cto:DetectionStrategy ;
    rdfs:label "Cinder 볼륨 단시간 다량 생성 감시"@ko .
kb:cinder_rule_snapshot_burst a cto:DetectionRule ;
    rdfs:label "5분 내 스냅샷 3회 이상 생성"@ko ;
    cto:ruleType "threshold" ;
    cto:usesEvent kb:cinder_evt_snapshot_create_end ;
    cto:groupBy "_context_project_id" ;
    cto:windowSeconds 300 ;
    cto:threshold 3 ;
    cto:alertTier kb:cinder_tier_watch ;
    cto:severity "medium" ;
    cto:condition "5분 내 스냅샷 3회 이상 생성 (동일 _context_project_id)" .
kb:cinder_strategy_snapshot_burst cto:implementedBy kb:cinder_rule_snapshot_burst .
kb:cinder_rule_volume_burst a cto:DetectionRule ;
    rdfs:label "5분 내 볼륨 5회 이상 생성"@ko ;
    cto:ruleType "threshold" ;
    cto:usesEvent kb:cinder_evt_volume_create_end ;
    cto:groupBy "_context_project_id" ;
    cto:windowSeconds 300 ;
    cto:threshold 5 ;
    cto:alertTier kb:cinder_tier_watch ;
    cto:severity "medium" ;
    cto:condition "5분 내 볼륨 5회 이상 생성 (동일 _context_project_id)" .
