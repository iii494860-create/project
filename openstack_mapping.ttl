# ---------------- 로그 필드

kb:f_ks_initiator_id a cto:LogField ;
    rdfs:label "행위자 사용자 ID"@ko ;
    cto:fieldPath "payload.initiator.id" ;
    cto:refersTo kb:res_user ;
    cto:isCorrelationKey true ;
    cto:derivedFrom kb:doc_keystone_notif ;
    cto:verificationStatus "공식문서확인" .

kb:f_ks_initiator_user_id a cto:LogField ;
    rdfs:label "행위자 user_id"@ko ;
    cto:fieldPath "payload.initiator.user_id" ;
    cto:refersTo kb:res_user ;
    cto:isCorrelationKey true ;
    cto:derivedFrom kb:doc_keystone_notif ;
    cto:verificationStatus "공식문서확인" .

kb:f_ks_initiator_username a cto:LogField ;
    rdfs:label "행위자 사용자명"@ko ;
    cto:fieldPath "payload.initiator.username" ;
    rdfs:comment "최신 문서 예시(2025)에 있음. 구버전 Keystone 에서는 없을 수 있음"@ko ;
    cto:derivedFrom kb:doc_keystone_notif ;
    cto:verificationStatus "공식문서확인" .

kb:f_ks_src_ip a cto:LogField ;
    rdfs:label "출발지 IP"@ko ;
    cto:fieldPath "payload.initiator.host.address" ;
    cto:isCorrelationKey true ;
    cto:derivedFrom kb:doc_keystone_notif ;
    cto:verificationStatus "공식문서확인" .

kb:f_ks_agent a cto:LogField ;
    rdfs:label "클라이언트 에이전트"@ko ;
    cto:fieldPath "payload.initiator.host.agent" ;
    cto:derivedFrom kb:doc_keystone_notif ;
    cto:verificationStatus "공식문서확인" .

kb:f_ks_request_id a cto:LogField ;
    rdfs:label "요청 ID"@ko ;
    cto:fieldPath "payload.initiator.request_id" ;
    rdfs:comment "최신 문서 예시(2025)에 있음. 구버전 Keystone 에서는 없을 수 있음"@ko ;
    cto:isCorrelationKey true ;
    cto:derivedFrom kb:doc_keystone_notif ;
    cto:verificationStatus "공식문서확인" .

kb:f_ks_action a cto:LogField ;
    rdfs:label "CADF 행위"@ko ;
    cto:fieldPath "payload.action" ;
    cto:derivedFrom kb:doc_keystone_notif ;
    cto:verificationStatus "공식문서확인" .

kb:f_ks_outcome a cto:LogField ;
    rdfs:label "결과"@ko ;
    cto:fieldPath "payload.outcome" ;
    cto:derivedFrom kb:doc_keystone_notif ;
    cto:verificationStatus "공식문서확인" .

kb:f_ks_target_id a cto:LogField ;
    rdfs:label "대상 ID"@ko ;
    cto:fieldPath "payload.target.id" ;
    cto:derivedFrom kb:doc_keystone_notif ;
    cto:verificationStatus "공식문서확인" .

kb:f_ks_target_type a cto:LogField ;
    rdfs:label "대상 typeURI"@ko ;
    cto:fieldPath "payload.target.typeURI" ;
    cto:derivedFrom kb:doc_keystone_notif ;
    cto:verificationStatus "공식문서확인" .

kb:f_ks_resource_info a cto:LogField ;
    rdfs:label "생성·변경된 자원 ID"@ko ;
    cto:fieldPath "payload.resource_info" ;
    cto:derivedFrom kb:doc_keystone_notif ;
    cto:verificationStatus "공식문서확인" .

kb:f_ks_reason_code a cto:LogField ;
    rdfs:label "사유 코드"@ko ;
    cto:fieldPath "payload.reason.reasonCode" ;
    cto:derivedFrom kb:doc_keystone_notif ;
    cto:verificationStatus "공식문서확인" .

kb:f_ks_pw_hash a cto:LogField ;
    rdfs:label "비밀번호 부분 해시"@ko ;
    cto:fieldPath "payload.attachments[name=partial_password_hash].content" ;
    rdfs:comment "Keystone 2025.1 이후 기능(report_invalid_password_hash). 이전 버전이면 필드가 없음 → 무차별 대입 규칙은 건수만으로 판단"@ko ;
    cto:derivedFrom kb:doc_keystone_notif ;
    cto:verificationStatus "공식문서확인" .

kb:f_ks_ra_role a cto:LogField ;
