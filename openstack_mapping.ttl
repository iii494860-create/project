# ---------------- 허용 목록 (예시. 실제 값은 클러스터에서 확인해 채움)

kb:allow_svc_nova a cto:AllowlistEntry ;
    cto:entryKind "service_account" ;
    cto:entryValue "nova" ;
    cto:verificationStatus "실로그확인필요" ;
