# CTO_CINDER_ONTOLOGY_EXTENSION_V1
# Ontology event/behavior definitions; no ATT&CK technique is inferred.
kb:cinder_bc_volume_create a cto:BehaviorClass ;
    rdfs:label "Cinder 볼륨 생성"@ko ;
    cto:riskScore 0 .
kb:cinder_bc_volume_delete a cto:BehaviorClass ;
    rdfs:label "Cinder 볼륨 삭제"@ko ;
