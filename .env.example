# Copy to .env and set values for this installation. Never commit .env.
NEO4J_URI=bolt://127.0.0.1:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=SET_DURING_INSTALL
NEO4J_DATABASE=neo4j

# Dashboard host interface. Keep localhost-only unless LAN access is needed.
DASHBOARD_BIND_ADDRESS=127.0.0.1

# OpenAI-compatible Qwen endpoint reachable from this PC/VM
QWEN_API_BASE_URL=http://127.0.0.1:11434/v1
QWEN_API_MODEL=qwen3.6:35b
QWEN_API_KEY=
QWEN_API_CONFIG=qwen_api_config.json

# Ollama-compatible embedding endpoint. Model must return 4096-dimensional vectors.
CTO_EMBED_LOCAL=true
CTO_EMBED_URL=http://127.0.0.1:11435
CTO_EMBED_MODEL=qwen3-embedding:8b

# Set one configured OpenStack cloud profile per dashboard process.
OPENSTACK_CLOUD=
OPENSTACK_AUTH_URL=
OPENSTACK_USERNAME=
CTO_OPENSTACK_PROJECT_ID=
CTO_OPENSTACK_PROJECT_NAME=

# Optional RabbitMQ notification queue
RABBIT_HOST=
RABBIT_PORT=5672
RABBIT_USER=
RABBIT_PASSWORD=
RABBIT_VHOST=/
RABBIT_QUEUE=
RABBIT_TLS=false
RABBIT_CA_FILE=
RABBIT_DECLARE_QUEUE=true
RABBIT_EXCHANGES=
RABBIT_ROUTING_KEYS=notifications.info,notifications.warn,notifications.error,versioned_notifications.info,versioned_notifications.warn,versioned_notifications.error
